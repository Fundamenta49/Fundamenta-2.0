# Adzuna API Credentials
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# Server Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeskillai

# Note: Replace all "your_*_here" values with actual API keys for the services you want to use
