# Core Environment Variables
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Core AI APIs
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Career & Learning APIs
CAREER_ONE_STOP_API_KEY=your_career_one_stop_api_key_here
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Financial APIs
VITE_FRED_API_KEY=your_fred_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Plaid Integration (Coming Soon)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox

# Food & Nutrition APIs
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here
